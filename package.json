  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "index.ts",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "zigpty": "^0.1.6"
  },
  "scripts": {
